# Modelo de configuracao do frontend.
#
# Copie para .env.local:
#   copy .env.local.example .env.local
#
# O prefixo NEXT_PUBLIC_ e obrigatorio para que a variavel chegue ao navegador.
# Consequencia direta: tudo que leva esse prefixo fica visivel para qualquer
# pessoa que abrir o DevTools. Segredo NUNCA recebe NEXT_PUBLIC_.
# Uma URL de API publica pode; uma chave de API, jamais.

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

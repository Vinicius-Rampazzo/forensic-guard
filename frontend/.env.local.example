# Modelo de configuracao do frontend.
#
# Copie para .env.local:
#   copy .env.local.example .env.local
#
# O prefixo NEXT_PUBLIC_ e obrigatorio para que a variavel chegue ao navegador.
# Consequencia direta: tudo que leva esse prefixo fica visivel para qualquer
# pessoa que abrir o DevTools. Segredo NUNCA recebe NEXT_PUBLIC_.
# Uma URL de API publica pode; uma chave de API, jamais.

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Endereco publico do site, usado no canonical, no sitemap e na imagem que
# aparece ao compartilhar o link.
#
# Precisa ser absoluto: quem monta o cartao de preview e um servidor do
# LinkedIn ou do WhatsApp, que nao tem como resolver um caminho relativo.
#
# Em desenvolvimento nao faz diferenca - ninguem compartilha localhost. Em
# producao, defina com o dominio de verdade. Sem ele, o padrao do codigo
# assume o endereco atual da Vercel.
# NEXT_PUBLIC_SITE_URL=https://www.forensicguard.com.br

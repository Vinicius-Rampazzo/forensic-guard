# ---------------------------------------------------------------------------
# Environment
# Segredos e configuracao local nunca entram no git.
# Os arquivos .example sao versionados: eles documentam o CONTRATO
# de quais variaveis existem, sem revelar valores.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.local.example

# ---------------------------------------------------------------------------
# Evidencias temporarias
# O ForensicGuard nao persiste evidencias. Se algum arquivo temporario
# escapar da limpeza, ele nunca deve chegar ao repositorio.
# ---------------------------------------------------------------------------
tmp/
temp/
backend/tmp/

# ---------------------------------------------------------------------------
# Editores e sistema operacional
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Modelo de configuracao do backend.
#
# Copie este arquivo para .env e ajuste o que precisar:
#   copy .env.example .env
#
# O .env real e ignorado pelo git. Este .example e versionado porque ele
# documenta QUAIS variaveis existem - sem revelar nenhum valor real.
#
# Todos os valores abaixo sao os defaults do codigo. O backend sobe sem .env.

# Identificacao exibida no /health e no /docs
APP_NAME=ForensicGuard
VERSION=0.1.0

# Origens autorizadas a chamar a API pelo navegador, separadas por virgula
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Tamanho maximo de upload, em bytes (25 MB)
MAX_UPLOAD_SIZE=26214400

# Pasta de trabalho para evidencias temporarias.
# Vazio = usa a pasta temporaria do sistema + /forensicguard
# TEMP_DIR=
